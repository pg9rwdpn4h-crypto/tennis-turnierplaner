rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/{tournamentId} {
      // The unguessable tournament ID is shared by link or QR code.
      allow get: if resource.data.published == true;
      allow list: if false;

      // Only the tournament organizer's verified Google account may write.
      function organizer() {
        return request.auth != null
          && request.auth.token.email == 'benedikth14@gmail.com'
          && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }

      function validTournament() {
        return request.resource.data.keys().hasOnly([
          'ownerUid', 'published', 'data', 'updatedAt'
        ])
          && request.resource.data.ownerUid is string
          && request.resource.data.published is bool
          && request.resource.data.data is map
          && request.resource.data.data.keys().hasOnly([
            'name', 'date', 'startTime', 'courts', 'duration',
            'breakDuration', 'format', 'mode', 'teams',
            'matches', 'generatedAt'
          ])
          && request.resource.data.data.name is string
          && request.resource.data.data.name.size() <= 80
          && request.resource.data.data.teams is list
          && request.resource.data.data.matches is list
          && request.resource.data.data.teams.size() <= 100
          && request.resource.data.data.matches.size() <= 2000;
      }

      allow create: if organizer()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.published == true
        && validTournament();
      allow update: if organizer()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validTournament();
      allow delete: if false;
    }

    match /organizers/{organizerUid}/tournaments/{tournamentId} {
      function organizer() {
        return request.auth != null
          && request.auth.uid == organizerUid
          && request.auth.token.email == 'benedikth14@gmail.com'
          && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }

      function validSavedTournament() {
        return request.resource.data.keys().hasOnly(['ownerUid', 'version', 'state', 'updatedAt'])
          && request.resource.data.ownerUid == organizerUid
          && request.resource.data.version is int
          && request.resource.data.state is map
          && request.resource.data.state.name is string
          && request.resource.data.state.name.size() <= 80
          && request.resource.data.state.matches is list
          && request.resource.data.state.matches.size() <= 2000
          && request.resource.data.updatedAt == request.time;
      }

      allow get, list: if organizer();
      allow create: if organizer() && validSavedTournament()
        && request.resource.data.version == 1;
      allow update: if organizer() && validSavedTournament()
        && resource.data.ownerUid == organizerUid
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }
  }
}

